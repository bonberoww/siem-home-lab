# ─── SIEM Home Lab — variables d'environnement ──────────────────────────────
# Copier ce fichier en .env puis remplacer les valeurs.
# Utiliser des mots de passe alphanumériques (pas de guillemets ni de $).

ELASTIC_PASSWORD=change-moi-elastic
KIBANA_PASSWORD=change-moi-kibana
# 32 caractères minimum
KIBANA_ENCRYPTION_KEY=change-moi-cle-de-32-caracteres-minimum

# Alertes (optionnel) : laisser vide pour désactiver un canal
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
